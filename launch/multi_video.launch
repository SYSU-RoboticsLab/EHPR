<launch>
  <arg name="rviz" default="true" />
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find ehpr)/rviz_cfg/multisession.rviz" />
  </group>

  <node pkg="ehpr" type="ehpr_multisession_video" name="ehpr_multisession_video" output="screen" />

</launch>